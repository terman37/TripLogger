<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
        Permissions needed by the trip monitor (see README / todo.md):
        - BLUETOOTH_CONNECT: observe the car device's connect/disconnect
          (dangerous permission → runtime request on Android 12+).
        - ACCESS_FINE_LOCATION: GPS fixes for distance and addresses
          (dangerous → runtime request).
        - POST_NOTIFICATIONS: show the foreground-service notification
          (dangerous → runtime request on Android 13+).
        - FOREGROUND_SERVICE + types: running the monitoring service; the
          types must match the <service> declaration below.
    -->
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <!-- Coarse is declared together with fine: on Android 12+ the user may
         grant only approximate location, and lint requires both declarations. -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <!-- Required so monitoring can resume after a reboot or app update: Android
         14+ refuses a location foreground service started from the background
         unless the app holds background location ("Allow all the time"). -->
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <!-- Wakes the app after a reboot so monitoring can resume: Android never
         restarts a foreground service by itself after the phone restarts. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!--
        Backup is disabled on purpose: trip records (times, coordinates, street
        and city) and the registered devices are personal data and the app
        promises local-only storage (see privacy-policy.html). Cloud backup
        would upload them to the user's Google Drive.

        dataExtractionRules stays because some Android 12+ manufacturers still
        migrate app files device-to-device even when allowBackup is false; the
        excludes in that file are what keep the trip database and the
        preferences (registered device MACs) off a transfer.
    -->
    <application
        android:name=".TripLoggerApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.TripLogger">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
            Foreground service hosting the Bluetooth monitor and the trip
            recorder. exported=false: only this app starts it. The foreground
            service type must be declared here AND granted at runtime before
            startForeground is called.
        -->
        <!-- Forwarded when the user swipes the monitoring notification away:
             monitoring must not stay on without a visible notification. -->
        <receiver
            android:name=".monitor.NotificationDismissReceiver"
            android:exported="false" />

        <!-- Restarts monitoring after a reboot or an app update. Without it the
             persisted switch would stay ON while the service is dead: no
             notification, no recording (silent monitoring). exported=false:
             only the system sends these protected broadcasts. -->
        <receiver
            android:name=".monitor.BootCompletedReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <service
            android:name=".monitor.TripMonitorService"
            android:exported="false"
            android:foregroundServiceType="connectedDevice|location" />

        <!--
            Shares exported Excel files with other apps via the system share
            sheet. Only files under cache/exports are exposed (file_paths.xml).
        -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

    </application>

</manifest>