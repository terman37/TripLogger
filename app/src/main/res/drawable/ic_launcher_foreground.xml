<?xml version="1.0" encoding="utf-8"?>
<!--
    Adaptive-icon foreground (user tuning): wider single S-shaped mint road with
    a dark centre stripe, and a large warm amber car seen from above. Kept
    inside the centre safe zone so every launcher mask clips nothing.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <!-- single S road -->
    <path
        android:fillColor="#00000000"
        android:strokeColor="#41D8B7"
        android:strokeWidth="24"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:pathData="M54,24 C82,40 26,68 54,84" />
    <!-- road centre stripe -->
    <path
        android:fillColor="#00000000"
        android:strokeColor="#101418"
        android:strokeWidth="4"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:pathData="M54,24 C82,40 26,68 54,84" />
    <!-- car body (amber, thin dark outline) -->
    <path
        android:fillColor="#FFD166"
        android:strokeColor="#101418"
        android:strokeWidth="2"
        android:pathData="M41,41q0,-5 5,-5h16q5,0 5,5v26q0,5 -5,5h-16q-5,0 -5,-5z" />
    <!-- windshield + rear window -->
    <path
        android:fillColor="#101418"
        android:pathData="M45,45h18v9h-18z M45,58h18v9h-18z" />
</vector>
