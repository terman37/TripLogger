    <path
        android:fillColor="#41D8B7"
        android:pathData="M44,0h20q8,0 8,8v92q0,8 -8,8h-20q-8,0 -8,-8v-92q0,-8 8,-8z" />
    <!-- dashed centre line -->
    <path
        android:fillColor="#101418"
        android:pathData="M52.5,8h3v8h-3z M52.5,24h3v8h-3z M52.5,40h3v8h-3z M52.5,56h3v8h-3z M52.5,72h3v8h-3z M52.5,88h3v8h-3z" />
    <!-- car body -->
    <path
        android:fillColor="#F5FFFC"
        android:pathData="M42,38q0,-6 6,-6h12q6,0 6,6v34q0,6 -6,6h-12q-6,0 -6,-6z" />
    <!-- windshield + rear window -->
    <path
        android:fillColor="#101418"
        android:pathData="M46,42h16v7h-16z M46,62h16v7h-16z" />
</vector>
