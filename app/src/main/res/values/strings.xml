<?xml version="1.0" encoding="utf-8"?>
<!--
    Default (base) resources: FRENCH.

    The app ships French-first (decision 2026-10-02, release_guide.md §6): this
    file is what Android falls back to for any device whose language has no
    translation folder, and English lives in ../values-en. Every key that is
    user-visible exists in both files; the parity is checked with the script
    documented in §6 phase L2.

    Notes for translators/maintainers:
    - Android needs apostrophes escaped as \' (they are part of the French text
      here, unlike English).
    - Positional placeholders (%1$s …) so a translation can reorder arguments.
    - translatable="false" entries (URLs, e-mail) live here only, once.
-->
<resources>
    <!-- App name under the launcher icon. Same in both languages (decision). -->
    <string name="app_name">TripToExcel</string>

    <!-- Foreground service notification: always leads with the monitoring text. -->
    <string name="notification_channel_name">Suivi des trajets</string>
    <string name="notification_monitoring_text">Suivi actif</string>
    <string name="notification_recording_label">Enregistrement</string>
    <string name="notification_disconnected_label">Déconnecté, fin du trajet…</string>
    <!-- Full notification lines: one string each so a translation can reorder
         the parts; the distance arrives already formatted for the locale. -->
    <string name="notification_recording_text">%1$s — %2$s %3$s</string>
    <string name="notification_grace_text">%1$s — %2$s</string>

    <!-- Why location must be "all the time": without it Android refuses to
         restart the location foreground service after a reboot (docs/DETAILS.md). -->
    <string name="background_location_dialog_title">Autoriser la localisation en permanence</string>
    <string name="background_location_dialog_text">Pour relancer le suivi automatiquement après un redémarrage du téléphone, TripToExcel a besoin d\'un accès à la localisation réglé sur « Autoriser en permanence ». Ouvrez les réglages de l\'application et choisissez cette option dans Autorisations, puis dans Localisation.</string>
    <string name="background_location_open_settings">Ouvrir les réglages</string>

