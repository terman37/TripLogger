<resources>
    <!-- App name shown under the launcher icon. -->
    <string name="app_name">TripToExcel</string>

    <!-- Foreground service notification (user request): always leads with
         "Monitoring active", the state follows after the dash. -->
    <string name="notification_channel_name">Trip monitoring</string>
    <string name="notification_monitoring_text">Monitoring active</string>
    <string name="notification_recording_label">Recording</string>
    <string name="notification_disconnected_label">Disconnected, finishing trip…</string>
    <!-- Full notification lines. Kept as one string each so a translation can
         reorder the parts; the distance arrives already formatted for the
         locale (phase L1b). -->
    <string name="notification_recording_text">%1$s — %2$s %3$s</string>
    <string name="notification_grace_text">%1$s — %2$s</string>

    <!-- Explains why location must be set to "Allow all the time": without it
         Android 14+ refuses to restart the location foreground service after a
         reboot (see docs/DETAILS.md). Android 11+ cannot ask for this in the
         runtime dialog, so the user is sent to the app's system settings. -->
    <string name="background_location_dialog_title">Allow location all the time</string>
    <string name="background_location_dialog_text">To restart monitoring by itself after the phone reboots, TripToExcel needs location access set to "Allow all the time". Open the app settings and choose that under Permissions, then Location.</string>
    <string name="background_location_open_settings">Open settings</string>

    <!-- About dialog, opened by the "?" button on Home. GPL-3.0-or-later only
         requires the source to be reachable while the app is distributed, so
         the dialog exists to make that offer (and the version) visible. URLs
         and the e-mail are not translatable. -->
    <string name="about_entry_title">About this app</string>
    <string name="about_entry_subtitle">Version, documentation and privacy policy</string>
    <string name="about_title">About</string>
    <string name="about_version">Version %1$s (build %2$d)</string>
    <string name="about_copyright">© 2026 Anthony Jourdan</string>
    <string name="about_licence">Free software under the GNU General Public License v3 or later, with no warranty.</string>
    <string name="about_documentation_link">Documentation</string>
    <string name="about_privacy_link">Privacy policy</string>
    <string name="about_contact_link">Send an e-mail</string>
    <string name="about_close">Close</string>

